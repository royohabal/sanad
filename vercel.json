{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "dist/index.mjs",
      "buildCommand": "pnpm --filter @workspace/api-server run build"
    },
    "sanad": {
      "root": "artifacts/sanad",
      "framework": "vite",
      "buildCommand": "PORT=26138 BASE_PATH=/ pnpm --filter @workspace/sanad run build",
      "outputDirectory": "dist/public",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "sanad"
      }
    }
  ]
}
